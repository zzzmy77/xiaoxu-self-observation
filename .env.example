# ── DeepSeek API ──
DEEPSEEK_API_KEY=你的DeepSeekAPIKey
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ── Flask ──
SECRET_KEY=改成随机字符串
FLASK_DEBUG=0
PORT=5000

# ── 数据库（默认 SQLite，生产环境用 PostgreSQL） ──
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── 日志 ──
# LOG_LEVEL=INFO        # DEBUG / INFO / WARNING / ERROR
# LOG_FILE=logs/app.log # 留空则输出到控制台

# ── 功能开关 ──
# DISABLE_VECTOR=1       # 关闭向量检索（生产不装 torch 时需启用）
# DISABLE_SCHEDULER=1    # 关闭定时任务（调试时用）
